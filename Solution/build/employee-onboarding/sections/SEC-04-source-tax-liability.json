                  "value": "no"
                },
                {
                  "item": "permit_type",
                  "value": "no"
                },
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "spouse_nationality",
                  "expect": "asked"
                }
