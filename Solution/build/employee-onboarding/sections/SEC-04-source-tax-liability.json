              "then": [
                {
                  "target": "permit_type",
                  "expect": "asked"
                },
                {
                  "target": "permit_type",
                  "expect": "required"
                }
              ],
              "source_refs": [
                "F-hr_transcript-d7431e"
              ],
              "illustrative": false
            },
            {
              "name": "Swiss citizen (also dual citizen) living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
