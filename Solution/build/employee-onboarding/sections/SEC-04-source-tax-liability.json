    {
      "id": "US-04.2",
      "title": "Ask spouse details only when the spouse could exempt the employee",
      "as_a": "source_tax",
      "i_want": "to know whether a married or registered-partner employee's spouse or partner is Swiss or holds a C permit, and whether they live in Switzerland, but only when this can change the employee's source tax liability",
      "so_that": "employees exempted through their spouse, such as Tomás, are not wrongly treated as subject to source tax, and no spouse data is collected when it cannot change the result",
      "priority": "P1",
      "priority_reason": "HR's real case Tomás shows that leaving out the spouse leads to the wrong liability decision (F-hr_transcript-d7431e). HR states which spouse facts are needed (F-hr_transcript-f3ce84).",
      "acceptance_criteria": [
        {
          "id": "AC-04.2.1",
          "title": "Spouse's Swiss citizenship is asked only when the spouse could exempt the employee",
          "given": "the employee lives in Switzerland, is not a Swiss citizen and holds no C permit",
          "when": "the employee's civil status is Married or Registered partnership",
          "then": "the employee is asked whether their spouse or registered partner holds Swiss citizenship (\"yes\" or \"no\"; dual citizens count as \"yes\") and must answer. It is not asked of Single, Divorced, Widowed or Separated employees, because separated employees count as single for source tax. It is not asked of employees who are Swiss, hold a C permit or live abroad. The answer is recorded for source tax.",
          "examples": [
            {
              "name": "Tomás (hr_transcript/F-hr_transcript-d7431e)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "no"
                },
