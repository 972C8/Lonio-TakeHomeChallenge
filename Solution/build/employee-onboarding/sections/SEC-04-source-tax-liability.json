{
  "id": "SEC-04-source-tax-liability",
  "order": 4,
  "title": "Source tax liability check",
  "purpose": "Decide from residence, Swiss citizenship, C permit and the spouse exemption whether the employee is subject to source tax. Ask these facts only as far as they are needed, so that only employees subject to source tax get the source tax questions.",
  "stories": [
    {
      "id": "US-04.1",
      "title": "Ask Swiss citizenship and C permit only of employees living in Switzerland",
      "as_a": "employee",
      "i_want": "to be asked whether I am a Swiss citizen and, if I am not, whether I hold a C permit, but only when I live in Switzerland and never for my full nationality or any other permit type",
      "so_that": "Lonio learns exactly what decides my source tax liability without collecting personal data that no receiving party needs",
      "priority": "P1",
      "priority_reason": "Swiss citizenship and C permit decide source tax liability. Today HR works this out by hand and does not know in advance who has to answer the source tax questions (F-hr_transcript-b6d9b3, F-hr_transcript-b84498).",
      "acceptance_criteria": [
        {
          "id": "AC-04.1.1",
          "title": "Swiss citizenship is asked only of employees living in Switzerland",
          "given": "the employee has entered the country of their home address",
          "when": "the country is Switzerland",
          "then": "the employee is asked whether they hold Swiss citizenship, with the answers \"yes\" or \"no\", and must answer. Employees whose home address is in another country are not asked, because they are subject to source tax whatever their nationality. The answer is recorded for source tax, and for HR to decide whether the permit reminder is shown.",
          "examples": [
            {
              "name": "Employee living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "asked"
                },
                {
                  "target": "nationality",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Konstanz, Germany (F-hr_transcript-1a20bb)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
              "name": "Employee living in Liechtenstein (F-hr_transcript-1a20bb)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": false
            }
          ],
          "source_refs": [
            "F-hr_transcript-35fae3",
            "F-hr_transcript-b6d9b3",
            "F-hr_transcript-1a20bb",
            "D-008",
            "D-010",
            "D-038",
            "G-01"
          ]
        },
        {
          "id": "AC-04.1.2",
          "title": "Dual citizens answer as Swiss citizens",
          "given": "an employee living in Switzerland holds Swiss citizenship and also another nationality",
          "when": "they answer the Swiss citizenship question",
          "then": "they answer \"yes\". Anyone with Swiss citizenship counts as Swiss for source tax. Their other nationality is not asked.",
          "examples": [],
          "source_refs": [
            "D-008",
            "G-01"
          ]
        },
        {
          "id": "AC-04.1.3",
          "title": "C permit is asked only of non-Swiss employees living in Switzerland",
          "given": "the employee lives in Switzerland",
          "when": "the employee has answered that they do not hold Swiss citizenship",
          "then": "the employee is asked whether they hold a C permit (permanent residence), with the answers \"yes\" or \"no\", and must answer. Swiss citizens and employees living abroad are not asked. No other permit type is asked. The answer is recorded for source tax.",
          "examples": [
