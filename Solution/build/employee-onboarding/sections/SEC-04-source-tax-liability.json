    {
      "id": "US-04.2",
      "title": "Ask spouse details only when the spouse could exempt the employee",
      "as_a": "hr",
      "i_want": "Lonio to ask about the spouse or registered partner (where they live, their nationality, their C permit) only when that can exempt the employee from source tax",
      "so_that": "employees like Tomás, married to a Swiss wife living in Switzerland, are correctly found not subject to source tax, without asking every married employee about their spouse",
      "priority": "P1",
      "priority_reason": "The spouse exemption decides source tax liability. A wrong decision gives a wrong tariff or asks source tax questions of people who do not need them. Data minimisation (G-01) limits the spouse questions to the cases where they decide something.",
      "acceptance_criteria": [
        {
          "id": "AC-04.2.1",
          "title": "Spouse's country of residence is asked first, and only when it can matter",
          "given": "the employee lives in Switzerland, is not Swiss and has answered \"no\" to holding a C permit",
          "when": "the employee's civil status is Married or Registered partnership",
          "then": "the employee is asked in which country their spouse or registered partner lives, given as a country by its English name, and must answer it. It is recorded for source tax. It is not asked of single, divorced, widowed or separated employees, because separated counts as single for source tax. It is also not asked of employees who are Swiss, hold a C permit or live abroad, because the spouse cannot change their liability. Asking the residence before nationality and permit is inferred from data minimisation: a spouse living outside Switzerland never exempts.",
          "examples": [
            {
              "name": "Tomás, Brazilian, B permit, married (hr_transcript/F-hr_transcript-d7431e)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Brazil"
                },
                {
                  "item": "permit_type",
                  "value": "no"
                },
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "spouse_residence_country",
                  "expect": "asked"
