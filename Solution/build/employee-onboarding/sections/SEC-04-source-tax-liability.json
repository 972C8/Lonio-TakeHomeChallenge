{
  "id": "SEC-04-source-tax-liability",
  "order": 4,
  "title": "Source tax liability check",
  "purpose": "Decide whether the employee is subject to source tax with as few questions as possible: home country, then nationality and C permit for residents of Switzerland, then the spouse's residence, nationality and C permit. Only employees subject to source tax get the tariff questions.",
  "stories": [
    {
      "id": "US-04.1",
      "title": "Ask Swiss citizenship and C permit only of employees living in Switzerland",
      "as_a": "employee",
      "i_want": "to give my nationality, and whether I hold a C permit, only when I live in Switzerland and it matters for my source tax liability",
      "so_that": "Lonio can tell whether I am subject to source tax without collecting personal data that no receiving party needs",
      "priority": "P1",
      "priority_reason": "Without nationality and C permit Lonio cannot decide source tax liability for residents of Switzerland. HR today does not know up front who has to answer the source tax questions. Data minimisation (G-01) makes asking too much a compliance issue.",
      "acceptance_criteria": [
        {
          "id": "AC-04.1.1",
          "title": "Nationality is asked only of employees living in Switzerland",
          "given": "the employee has entered the country of their home address",
          "when": "the employee reaches the nationality and permit step",
          "then": "the nationality is asked, and must be answered, only if the home address country is Switzerland. Employees living abroad are not asked for their nationality, because they are subject to source tax whatever their nationality. The nationality is recorded for source tax and for HR, which uses it for the permit reminder to non-Swiss employees.",
          "examples": [
            {
              "name": "Swiss citizen living abroad, like Stefan (hr_transcript/F-hr_transcript-1a20bb)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                },
                {
                  "target": "permit_type",
                  "expect": "not asked"
                }
              ],
              "source_refs": [
                "F-hr_transcript-1a20bb",
                "D-038"
              ],
              "illustrative": true
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [
                "F-hr_transcript-1a20bb",
                "D-007"
              ],
              "illustrative": true
            },
            {
              "name": "Tomás, Brazilian living in Winterthur (hr_transcript/F-hr_transcript-d7431e)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "asked"
                },
                {
                  "target": "nationality",
                  "expect": "required"
                }
              ],
              "source_refs": [
                "F-hr_transcript-d7431e"
              ],
              "illustrative": false
            }
          ],
          "source_refs": [
            "F-hr_transcript-35fae3",
            "F-hr_transcript-1a20bb",
            "F-hr_transcript-b6d9b3",
            "G-01",
            "D-010",
            "D-038"
          ]
        },
        {
          "id": "AC-04.1.2",
          "title": "Nationality is given as a country; Swiss citizens answer Switzerland",
          "given": "the employee lives in Switzerland and is asked for their nationality",
          "when": "the employee answers",
          "then": "the nationality is given as a country by its English name (e.g. \"Switzerland\", \"Germany\"). Anyone holding Swiss citizenship answers \"Switzerland\", even if they also hold another nationality, and counts as Swiss for source tax. Whether to ask only 'Swiss citizen yes/no' instead is open (see OQ-nationality-wording).",
          "examples": [],
          "source_refs": [
            "F-hr_transcript-35fae3",
            "G-10",
            "D-008"
          ]
        },
        {
          "id": "AC-04.1.3",
          "title": "C permit is asked only of non-Swiss employees living in Switzerland",
          "given": "the employee lives in Switzerland and has given their nationality",
          "when": "the nationality is not Switzerland",
          "then": "the employee is asked whether they hold a C permit (permanent residence), answered with \"yes\" or \"no\", and must answer it. The answer is recorded for source tax. Swiss employees and employees living abroad are not asked.",
          "examples": [
            {
