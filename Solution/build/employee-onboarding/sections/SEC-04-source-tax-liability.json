    {
      "id": "US-04.3",
      "title": "Decide whether the employee is subject to source tax",
      "as_a": "hr",
      "i_want": "Lonio to decide from the employee's answers whether they are subject to source tax, and to ask the source tax questions only of those who are",
      "so_that": "I no longer have to work out up front who must answer the source tax questions, and only subject employees give that data",
      "priority": "P1",
