{
  "id": "SEC-04-source-tax-liability",
  "order": 4,
  "title": "Source tax liability check",
  "purpose": "Decide from residence, Swiss citizenship, C permit and the spouse exemption whether the employee is subject to source tax. Ask these facts only as far as they are needed, so that only employees subject to source tax get the source tax questions.",
  "stories": [
    {
      "id": "US-04.1",
      "title": "Ask nationality and C permit only of employees living in Switzerland",
      "as_a": "hr",
      "i_want": "Lonio to ask employees living in Switzerland for their nationality and, if they are not Swiss, only whether they hold a C permit",
      "so_that": "I know for each new employee whether they could be subject to source tax, without collecting nationality or permit data that no party needs",
      "priority": "P1",
      "priority_reason": "HR today never knows up front who has to answer the source tax questions (F-hr_transcript-b84498); without these facts the source tax liability cannot be decided and the tariff code cannot be computed.",
      "acceptance_criteria": [
        {
          "id": "AC-04.1.1",
          "title": "Nationality is asked only of employees living in Switzerland",
          "given": "the employee has entered their home address",
          "when": "the home address country is Switzerland",
          "then": "the employee is asked for their nationality (countries by English name) and must answer it; employees living abroad are not asked, because they are subject to source tax whatever their nationality and get the permit reminder anyway. Whether the specific nationality or only 'Swiss citizen yes/no' is needed stays open (see OQ-nationality-scope).",
          "examples": [
            {
              "name": "Tomás (hr_transcript/F-hr_transcript-d7431e)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "asked"
                },
                {
                  "target": "nationality",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
              "name": "Stefan, Swiss living abroad (hr_transcript/F-hr_transcript-1a20bb)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                },
                {
                  "target": "permit_type",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-b6d9b3",
            "F-hr_transcript-1a20bb",
            "F-hr_transcript-35fae3",
            "G-01",
            "D-010"
          ]
        },
        {
          "id": "AC-04.1.2",
          "title": "Swiss citizenship counts even with another nationality",
          "given": "an employee living in Switzerland holds Swiss citizenship, alone or together with another nationality",
          "when": "they answer the nationality question",
          "then": "they answer Switzerland, they count as Swiss and are not asked about a C permit",
          "examples": [
            {
              "name": "Swiss (or dual Swiss) employee living in Switzerland",
              "given": [
                {
                  "item": "address_country",
