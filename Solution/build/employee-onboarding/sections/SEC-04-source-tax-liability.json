        {
          "id": "AC-04.1.4",
          "title": "The permit type itself is never asked",
          "given": "a non-Swiss employee living in Switzerland",
          "when": "the employee answers the permit question",
          "then": "Lonio only asks whether they hold a C permit. It does not ask which other permit they hold (e.g. B permit), because no receiving party needs it.",
