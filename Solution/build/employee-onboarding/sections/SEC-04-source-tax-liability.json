    {
      "id": "US-04.3",
      "title": "Decide whether the employee is subject to source tax",
      "as_a": "hr",
      "i_want": "Lonio to decide from residence, Swiss citizenship, C permit and the spouse exemption whether a new employee is subject to source tax",
      "so_that": "only employees subject to source tax get the source tax questions and a tariff result, and I no longer decide this by hand",
      "priority": "P1",
      "priority_reason": "HR decides source tax liability by hand today and never knows up front who must answer the source tax questions (F-hr_transcript-b84498); the whole source tax step depends on this decision.",
      "acceptance_criteria": [
        {
          "id": "AC-04.3.1",
          "title": "Employees living abroad are always subject to source tax",
          "given": "the employee's home address country is not Switzerland",
          "when": "Lonio decides source tax liability",
          "then": "the employee is subject to source tax whatever their nationality, even if Swiss; this includes residents of Liechtenstein, whose result then follows the Liechtenstein questions",
          "examples": [
            {
              "name": "Stefan, Swiss living abroad (hr_transcript/F-hr_transcript-1a20bb)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
