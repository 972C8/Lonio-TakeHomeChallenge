{
  "id": "SEC-04-civil-status-spouse",
  "order": 4,
  "title": "Civil status and spouse data",
  "purpose": "Ask every employee for their civil status, using six values. Map it to the pension fund's four values and to the calculator's two groups. Ask the spouse's or registered partner's date of birth only of married, registered-partner and separated employees.",
  "stories": [
    {
      "id": "US-04.1",
      "title": "Ask every employee for their civil status",
      "as_a": "employee",
      "i_want": "to state my civil status once, in step 4 'Civil status and spouse' of the onboarding questionnaire, choosing from a list that matches my real situation",
      "so_that": "Lonio can register me with the pension fund and work out my source tax tariff without asking me the same thing again for each party",
      "priority": "P1",
      "priority_reason": "The pension fund requires a civil status to register the employee, and the source tax tariff depends on it. Without it, the registration and the tariff are blocked.",
      "acceptance_criteria": [
        {
          "id": "AC-04.1.1",
          "title": "Civil status is asked of everyone and is required",
          "given": "an employee is filling in the questionnaire, wherever they live",
          "when": "they reach step 4 'Civil status and spouse'",
          "then": "they are asked for their civil status and cannot submit the questionnaire without answering. The answer is recorded for the pension fund and for source tax. Assumption to be verified by a domain expert: the step order follows the agreed eight-step list (D-047).",
          "examples": [
            {
              "name": "Daniel, registered partnership (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [
                "F-hr_transcript-3907fe"
              ],
              "illustrative": false
            },
            {
              "name": "Single employee living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Married employee living in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                },
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-ce8ca4",
            "F-pension_portal-8664f4",
            "F-zh_source_tax_calculator-051bb9",
            "D-047"
          ]
        },
        {
          "id": "AC-04.1.2",
          "title": "Six civil status values are offered",
          "given": "an employee is asked for their civil status",
          "when": "they choose an answer",
          "then": "they can choose exactly one of: Single, Married, Divorced, Widowed, Registered partnership, Separated. The fund's list has only the first four. Registered partnership and Separated are added because the source tax calculator treats them in a specific way and registered partnerships do occur at Muster AG. Assumption to be verified by a domain expert (D-003).",
          "examples": [],
          "source_refs": [
            "F-pension_portal-3d1ae4",
            "F-zh_source_tax_calculator-051bb9",
            "F-hr_transcript-3907fe",
            "D-003",
            "G-10"
          ]
        }
