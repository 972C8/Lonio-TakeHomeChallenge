    {
      "id": "US-04.3",
      "title": "Answer the calculator's civil status question from the employee's civil status",
      "as_a": "source_tax",
      "i_want": "the employee's civil status to be put into the calculator's two groups the same way the Zurich calculator does it",
      "so_that": "the computed tariff code uses the right civil status group without anyone clicking through the calculator",
      "priority": "P1",
      "priority_reason": "The full tariff code is computed by Lonio and replaces HR's manual calculator step (D-001). A wrong group gives a wrong tariff.",
      "acceptance_criteria": [
        {
          "id": "AC-04.3.1",
          "title": "Civil status mapped to the calculator's two groups",
          "given": "an employee has answered the civil status question",
          "when": "Lonio works out the civil status for source tax",
          "then": "Married and Registered partnership count as 'Married or registered partnership'. Single, Divorced, Widowed and Separated count as 'Single, divorced, separated or widowed'. This follows the calculator's two options. Assumption to be verified by a domain expert: a registered partnership is treated as married, including the spouse exemption, and Separated is treated as single (D-003). The result is always worked out again from the latest civil status, including after HR changes it (D-037).",
          "examples": [
            {
              "name": "Daniel, registered partnership (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "calculator_civil_status",
                  "expect": "Married or registered partnership"
                }
              ],
              "source_refs": [
                "F-hr_transcript-3907fe",
                "D-003"
              ],
              "illustrative": false
            },
