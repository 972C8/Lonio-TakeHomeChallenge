                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Separated employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Separated"
                }
              ],
              "then": [
                {
                  "target": "pension_fund_civil_status",
                  "expect": "Married"
                }
              ],
              "source_refs": [],
