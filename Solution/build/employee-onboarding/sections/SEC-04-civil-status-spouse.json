    {
      "id": "US-04.2",
      "title": "Ask the spouse's date of birth when the employee is married",
      "as_a": "pension_fund",
      "i_want": "the date of birth of the employee's spouse or registered partner whenever the employee is registered with me as Married",
      "so_that": "the registration is not blocked by an empty 'Spouse's date of birth' field",
      "priority": "P1",
      "priority_reason": "The fund blocks the registration with 'Spouse's date of birth is required.' when the civil status is Married and the field is empty (F-pension_portal-c5ee15).",
      "acceptance_criteria": [
        {
          "id": "AC-04.2.1",
          "title": "Asked of married, registered-partnership and separated employees",
          "given": "the employee has answered the civil status question (all civil statuses are asked of everyone)",
          "when": "the civil status is Married, Registered partnership or Separated",
          "then": "the employee is asked for the date of birth of their spouse or registered partner (for separated employees: the spouse they are separated from), and it is required. It is recorded for the pension fund, because all three are entered at the fund as Married, which requires this field.",
          "examples": [
            {
              "name": "Daniel (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "spouse_date_of_birth",
                  "expect": "asked"
                },
                {
                  "target": "spouse_date_of_birth",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
              "name": "Married employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "spouse_date_of_birth",
                  "expect": "asked"
                },
                {
                  "target": "spouse_date_of_birth",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Separated employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Separated"
                }
              ],
              "then": [
                {
                  "target": "spouse_date_of_birth",
                  "expect": "asked"
                },
                {
                  "target": "spouse_date_of_birth",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-2334d8",
            "F-pension_portal-39bab1",
            "F-pension_portal-c5ee15",
            "D-003",
            "D-004"
          ]
        },
        {
          "id": "AC-04.2.2",
          "title": "Not asked of single, divorced or widowed employees",
          "given": "the employee has answered the civil status question",
          "when": "the civil status is Single, Divorced or Widowed",
          "then": "the spouse's date of birth is not asked. For Divorced and Widowed this rests on the assumption that the fund's screen shows no spouse field for these values (see OQ-spouse-dob-other-status).",
          "examples": [
