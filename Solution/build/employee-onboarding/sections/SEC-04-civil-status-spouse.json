              "given": [
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "pension_fund_civil_status",
                  "expect": "Single"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Married employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "pension_fund_civil_status",
                  "expect": "Married"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Divorced employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Divorced"
                }
              ],
              "then": [
                {
                  "target": "pension_fund_civil_status",
                  "expect": "Divorced"
                }
              ],
              "source_refs": [],
