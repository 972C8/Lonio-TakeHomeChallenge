    {
      "id": "US-04.3",
      "title": "Answer the calculator's civil status question from the employee's civil status",
      "as_a": "source_tax",
      "i_want": "Lonio to place the employee in the calculator's civil status group from the civil status they already gave",
      "so_that": "the tariff code is computed correctly without asking the civil status a second time",
      "priority": "P1",
      "priority_reason": "The civil status group decides the spouse exemption and tariff letter of the computed tariff code (D-001), which replaces HR's manual calculator step.",
      "acceptance_criteria": [
        {
          "id": "AC-04.3.1",
          "title": "Civil status group for source tax",
          "given": "an employee subject to source tax who has answered the civil status question",
          "when": "Lonio determines the civil status group for the source tax tariff",
          "then": "Married and Registered partnership give 'Married or registered partnership'; Single, Divorced, Widowed and Separated give 'Single, divorced, separated or widowed', as in the calculator. No separate source tax civil status question is asked. The group is always derived from the latest recorded civil status.",
          "examples": [
            {
              "name": "Daniel (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "calculator_civil_status",
                  "expect": "Married or registered partnership"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
              "name": "Married employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "calculator_civil_status",
                  "expect": "Married or registered partnership"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Single employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "calculator_civil_status",
                  "expect": "Single, divorced, separated or widowed"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Divorced employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Divorced"
                }
              ],
              "then": [
                {
                  "target": "calculator_civil_status",
                  "expect": "Single, divorced, separated or widowed"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Widowed employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Widowed"
                }
              ],
              "then": [
                {
                  "target": "calculator_civil_status",
                  "expect": "Single, divorced, separated or widowed"
                }
