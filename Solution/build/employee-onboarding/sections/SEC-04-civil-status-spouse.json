{
  "id": "SEC-04-civil-status-spouse",
  "order": 4,
  "title": "Civil status and spouse data",
  "purpose": "Ask the civil status once and map it both to the pension fund's list and to the calculator's civil status group. The spouse's or partner's date of birth is asked only where the fund needs it.",
  "stories": [
    {
      "id": "US-04.1",
      "title": "Ask the employee's civil status using the pension fund's list",
      "as_a": "pension_fund",
      "i_want": "every new employee to state their civil status once, and Lonio to record it in the form my registration accepts (Single, Married, Divorced or Widowed)",
      "so_that": "the required 'Civil status' field of the registration is always filled and the registration is not blocked",
      "priority": "P1",
      "priority_reason": "Civil status is a required field of the fund registration (F-pension_portal-8664f4); without it the registration is blocked. Registered partnerships occur today (Daniel, F-hr_transcript-3907fe) and do not fit the fund's list.",
      "acceptance_criteria": [
        {
          "id": "AC-04.1.1",
          "title": "Civil status is asked of every employee and is required",
          "given": "a new employee filling in the onboarding questionnaire",
          "when": "they reach the civil status question",
          "then": "the civil status is asked of every employee, whatever their residence or nationality, and the questionnaire cannot be submitted without an answer. The answer is recorded for the pension fund (required field 'Civil status') and, for employees subject to source tax, used for the source tax tariff.",
          "examples": [
            {
              "name": "Employee living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-ce8ca4",
            "F-pension_portal-8664f4",
            "F-zh_source_tax_calculator-9007c3"
          ]
        },
        {
          "id": "AC-04.1.2",
          "title": "Allowed civil status values",
          "given": "the civil status question",
          "when": "the employee answers it",
          "then": "the employee chooses exactly one of: Single, Married, Divorced, Widowed, Registered partnership, Separated. 'Registered partnership' and 'Separated' are offered in addition to the fund's four values because these cases occur and source tax treats them differently.",
          "examples": [],
          "source_refs": [
            "F-pension_portal-3d1ae4",
            "F-hr_transcript-bd8c8e",
            "F-hr_transcript-3907fe",
            "F-zh_source_tax_calculator-051bb9",
            "G-10",
            "D-003"
          ]
        },
        {
          "id": "AC-04.1.3",
          "title": "Civil status recorded for the pension fund",
          "given": "the employee has answered the civil status",
          "when": "Lonio records the civil status for the pension fund",
          "then": "Single, Married, Divorced and Widowed are recorded unchanged. Registered partnership and Separated are recorded provisionally as Married, because the fund's list has no such values (see OQ-civil-status-partnership, to be verified with Pensionskasse Muster).",
          "examples": [
            {
              "name": "Daniel (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "pension_fund_civil_status",
                  "expect": "Married"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
