    {
      "id": "US-03.3",
      "title": "Enter the civil status in the pension fund's terms",
      "as_a": "pension_fund",
      "i_want": "every employee's civil status to be recorded as one of the values on my list: Single, Married, Divorced or Widowed",
      "so_that": "the employee can be registered even when they are in a registered partnership or separated, which my list does not offer",
      "priority": "P1",
      "priority_reason": "The fund's field is required and offers only four values. Without a mapping, partnered and separated employees (for example Daniel) cannot be registered.",
      "acceptance_criteria": [
        {
          "id": "AC-03.3.1",
          "title": "Civil status for the pension fund",
          "given": "the employee has stated their civil status",
          "when": "Lonio records the civil status for the pension fund",
          "then": "Single, Married, Divorced and Widowed are recorded unchanged. Registered partnership is provisionally recorded as Married, together with the partner's date of birth. Separated is provisionally recorded as Married, together with the date of birth of the spouse they are separated from. Both provisional mappings still have to be checked with a domain expert and the fund (see OQ-civil-status-partnership). The fund's civil status is always derived again from the latest civil status.",
          "examples": [
            {
              "name": "Single",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
