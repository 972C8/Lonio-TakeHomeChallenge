      "title": "Ask the spouse's date of birth from married employees",
      "as_a": "pension_fund",
      "i_want": "the date of birth of the husband, wife or registered partner for every employee registered with me as Married",
      "so_that": "the registration is not rejected for a missing spouse's date of birth",
      "priority": "P1",
      "priority_reason": "The fund rejects a Married registration without the spouse's date of birth ('Spouse's date of birth is required.'), which blocks the registration.",
      "acceptance_criteria": [
