    {
      "id": "US-03.4",
      "title": "Group the civil status for source tax",
      "as_a": "source_tax",
      "i_want": "the employee's civil status grouped into married (married or registered partnership) or single (single, divorced, separated, widowed), as the calculator does",
      "so_that": "the spouse exemption and the tariff code are determined from the same civil status answer, without asking again",
      "priority": "P1",
      "priority_reason": "Lonio now computes the tariff code itself (D-001); married vs single decides the tariff letter and whether the spouse exemption can apply.",
      "acceptance_criteria": [
        {
          "id": "AC-03.4.1",
          "title": "Married and registered partnership count as married",
          "given": "the employee answered Married or Registered partnership",
          "when": "the civil status for source tax is determined",
          "then": "the employee counts as married for source tax, including for the spouse exemption",
          "examples": [
            {
              "name": "Married employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "married"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Daniel (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "married"
                }
              ],
              "source_refs": [],
              "illustrative": false
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-051bb9",
            "D-003"
          ]
        },
        {
          "id": "AC-03.4.2",
          "title": "Single, divorced, separated and widowed count as single",
          "given": "the employee answered Single, Divorced, Separated or Widowed",
          "when": "the civil status for source tax is determined",
          "then": "the employee counts as single for source tax; a separated employee therefore gets no spouse exemption, even though the fund registers them as Married",
          "examples": [
            {
              "name": "Single",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Single"
                }
