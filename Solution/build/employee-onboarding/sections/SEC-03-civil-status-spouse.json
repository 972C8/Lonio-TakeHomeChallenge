{
  "id": "SEC-03-civil-status-spouse",
  "order": 3,
  "title": "Civil status and spouse for the pension fund",
  "purpose": "Ask the civil status once. Map it to the fund's list and to married/single for source tax. Ask the spouse's or partner's date of birth only where the fund requires it.",
  "stories": [
    {
      "id": "US-03.1",
      "title": "Ask the civil status once, using the pension fund's list",
      "as_a": "employee",
      "i_want": "to state my civil status once, choosing from a list that also covers registered partnership and separation",
      "so_that": "both the pension fund and source tax get my civil status without being asked twice, and my real situation can be recorded",
      "priority": "P1",
      "priority_reason": "Civil status is a required field of the pension fund registration; without it the registration is blocked. It also decides the source tax tariff.",
      "acceptance_criteria": [
        {
          "id": "AC-03.1.1",
          "title": "Civil status is asked of every employee and is required",
          "given": "a new employee filling in the questionnaire",
          "when": "they reach the family step",
          "then": "they are asked their civil status, whatever their residence or nationality, and cannot submit the questionnaire without answering it",
          "examples": [
            {
              "name": "Employee living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living abroad",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-ce8ca4",
            "F-pension_portal-ec4512",
            "F-zh_source_tax_calculator-9007c3"
          ]
        },
        {
          "id": "AC-03.1.2",
          "title": "Allowed civil status values",
          "given": "the employee is asked their civil status",
          "when": "they choose an answer",
          "then": "they can choose exactly one of: Single, Married, Divorced, Widowed, Registered partnership, Separated",
          "examples": [],
          "source_refs": [
            "F-pension_portal-3d1ae4",
            "F-zh_source_tax_calculator-051bb9",
            "F-hr_transcript-3907fe",
            "D-003"
          ]
        },
        {
          "id": "AC-03.1.3",
          "title": "One answer serves both receiving parties",
          "given": "the employee has answered their civil status",
          "when": "the questionnaire is submitted",
          "then": "the answer is recorded once and is used both for the pension fund registration (see US-03.3) and for source tax (see US-03.4); the employee is not asked their civil status a second time",
          "examples": [],
          "source_refs": [
            "F-hr_transcript-ce8ca4",
            "F-zh_source_tax_calculator-9007c3",
            "G-01",
            "D-003"
          ]
        }
      ],
