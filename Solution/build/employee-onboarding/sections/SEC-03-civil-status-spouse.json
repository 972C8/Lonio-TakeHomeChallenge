    {
      "id": "US-03.2",
      "title": "Ask the spouse's or partner's date of birth from married, partnered and separated employees",
      "as_a": "pension_fund",
      "i_want": "to receive the date of birth of the husband, wife or registered partner of every employee who is registered with me as Married",
      "so_that": "the registration is not rejected with 'Spouse's date of birth is required'",
      "priority": "P1",
      "priority_reason": "The fund rejects a Married registration when the spouse's date of birth is missing, so the registration is blocked without it.",
      "acceptance_criteria": [
        {
          "id": "AC-03.2.1",
          "title": "Asked and required only for Married, Registered partnership and Separated",
          "given": "the employee has stated their civil status",
          "when": "the civil status is Married, Registered partnership or Separated",
          "then": "Lonio asks for the date of birth of the spouse or registered partner. For separated employees this is the spouse they are separated from. The answer is required, and it is recorded for the pension fund. Single, divorced and widowed employees are not asked. Whether the fund needs anything for Divorced or Widowed is still open (see OQ-spouse-dob-other-status), and so is the provisional handling of partnered and separated employees (see OQ-civil-status-partnership).",
