    {
      "id": "US-03.4",
      "title": "Group the civil status for source tax",
      "as_a": "source_tax",
      "i_want": "each employee's civil status to be sorted into one of the calculator's two groups: 'married or registered partnership' or 'single, divorced, separated or widowed'",
      "so_that": "the tariff code, the spouse exemption and the follow-up source tax questions use the calculator's logic",
      "priority": "P1",
      "priority_reason": "Lonio now computes the tariff code itself instead of HR using the calculator. A wrong group gives a wrong tariff letter.",
      "acceptance_criteria": [
        {
          "id": "AC-03.4.1",
          "title": "Civil status group for source tax",
          "given": "the employee has stated their civil status",
          "when": "Lonio derives the civil status for source tax",
          "then": "Married and Registered partnership count as 'married or registered partnership'. Registered partners therefore also qualify for the spouse exemption. Single, Divorced, Widowed and Separated count as 'single, divorced, separated or widowed'. Separated employees therefore get no spouse exemption. The group is always derived again from the latest civil status.",
          "examples": [
            {
              "name": "Married",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "Married or registered partnership"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Daniel, registered partnership (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "Married or registered partnership"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
              "name": "Single",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "Single, divorced, separated or widowed"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Divorced",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Divorced"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "Single, divorced, separated or widowed"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Widowed",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Widowed"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "Single, divorced, separated or widowed"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Separated",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Separated"
                }
              ],
              "then": [
                {
                  "target": "source_tax_civil_status",
                  "expect": "Single, divorced, separated or widowed"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-051bb9",
            "D-003",
            "D-037"
          ]
        },
        {
          "id": "AC-03.4.2",
          "title": "Separated: Married for the fund, single for source tax",
          "given": "a separated employee",
          "when": "Lonio derives the civil status for each party",
          "then": "the pension fund gets Married (provisional, see OQ-civil-status-partnership), and source tax counts the employee as single. Both results come from the one civil status answer; the employee is not asked anything twice.",
          "examples": [
