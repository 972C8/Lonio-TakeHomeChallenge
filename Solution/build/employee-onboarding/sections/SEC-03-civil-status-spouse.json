    {
      "id": "US-03.3",
      "title": "Enter the civil status in the pension fund's terms",
      "as_a": "pension_fund",
      "i_want": "every employee's civil status expressed as one of my options (Single, Married, Divorced, Widowed)",
      "so_that": "every new employee can be registered, including registered partners and separated employees, for whom my list has no option",
      "priority": "P1",
      "priority_reason": "The fund's list lacks Registered partnership and Separated; without a mapping such employees (e.g. Daniel) cannot be registered.",
      "acceptance_criteria": [
        {
          "id": "AC-03.3.1",
          "title": "Civil statuses on the fund's list are taken over as they are",
          "given": "the employee answered Single, Married, Divorced or Widowed",
          "when": "the civil status for the pension fund is determined",
          "then": "it is the same value as the employee's answer",
          "examples": [
