{
  "id": "SEC-03-civil-status-spouse",
  "order": 3,
  "title": "Civil status and spouse for the pension fund",
  "purpose": "Ask the civil status once. Map it to the fund's list and to married/single for source tax. Ask the spouse's or partner's date of birth only where the fund requires it.",
  "stories": [
    {
      "id": "US-03.1",
      "title": "Ask the civil status once, using the pension fund's list",
      "as_a": "employee",
      "i_want": "to state my civil status once, choosing from a list that also covers registered partnership and separation",
      "so_that": "I am not asked the same thing again for the pension fund and for source tax, and my real situation can be recorded",
      "priority": "P1",
      "priority_reason": "The pension fund's 'Civil status' field is required, so the registration cannot go ahead without it. Source tax needs it as well to decide married or single.",
      "acceptance_criteria": [
        {
          "id": "AC-03.1.1",
          "title": "Civil status is asked of every employee and is required",
          "given": "a new employee is filling in the onboarding questionnaire",
          "when": "they reach the civil status and spouse step",
          "then": "Lonio asks for their civil status. The question cannot be left empty. Lonio asks it only once, and the same answer is used for the pension fund and, if the employee is subject to source tax, for source tax.",
          "examples": [
            {
              "name": "Single employee",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Daniel, registered partnership (hr_transcript/F-hr_transcript-3907fe)",
              "given": [
                {
                  "item": "civil_status",
                  "value": "Registered partnership"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "civil_status",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": false
            }
          ],
          "source_refs": [
            "F-hr_transcript-ce8ca4",
            "F-pension_portal-ec4512",
            "F-zh_source_tax_calculator-9007c3",
            "G-01",
            "D-003"
          ]
        },
        {
          "id": "AC-03.1.2",
          "title": "Allowed civil status values",
          "given": "the employee is asked for their civil status",
          "when": "they choose an answer",
          "then": "they can choose exactly one of these: Single, Married, Divorced, Widowed, Registered partnership, Separated. The first four use the wording of the pension fund's list. Registered partnership and Separated are added so that a partnered or separated employee does not have to pick a value that does not describe them.",
          "examples": [],
          "source_refs": [
            "F-pension_portal-3d1ae4",
            "F-zh_source_tax_calculator-051bb9",
            "F-hr_transcript-3907fe",
            "G-10",
            "D-003"
          ]
        }
      ],
