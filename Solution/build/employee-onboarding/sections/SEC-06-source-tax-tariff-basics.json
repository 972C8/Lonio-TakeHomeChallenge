{
  "id": "SEC-06-source-tax-tariff-basics",
  "order": 6,
  "title": "Source tax tariff: income, denomination and spouse employment",
  "purpose": "For employees subject to source tax only, ask the calculator's income type, denomination and spouse employment questions that set the base tariff letter and the church-tax suffix.",
  "stories": [
    {
      "id": "US-06.1",
      "title": "Ask the type of income only of employees subject to source tax",
      "as_a": "source_tax",
      "i_want": "employees who are subject to source tax (rule subject_to_source_tax) to state whether the tariff is determined for earned income or replacement income",
      "so_that": "the Zurich tariff calculator's first question is answered and the right tariff path (earned income or replacement income) is followed, while employees not subject to source tax are not asked",
      "priority": "P2",
      "priority_reason": "Needed to start the calculator path, but for a new hire the answer is presumably always earned income and may be fixed by a product decision (see OQ-income-type); the source tax pain points are mainly about who answers and the spouse follow-ups.",
      "acceptance_criteria": [
        {
          "id": "AC-06.1.1",
          "title": "Income type is asked and required only when the employee is subject to source tax",
          "given": "the employee's answers on residence, nationality, permit, civil status and spouse decide whether they are subject to source tax (rule subject_to_source_tax)",
          "when": "the employee reaches the source tax step",
          "then": "the type of income question is asked and must be answered if the employee is subject to source tax; it is not asked at all if the employee is not subject. Until the open question OQ-income-type is decided, the question is asked rather than fixed to earned income.",
          "examples": [
            {
              "name": "Tomás (hr_transcript/F-hr_transcript-b90bd9): married to a Swiss wife living in Switzerland, not subject",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Brazil"
                },
                {
                  "item": "permit_type",
                  "value": "B permit"
                },
                {
                  "item": "civil_status",
                  "value": "Married"
                },
                {
                  "item": "spouse_nationality",
                  "value": "Switzerland"
                },
                {
                  "item": "spouse_residence_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "no"
                },
                {
                  "target": "income_type",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
