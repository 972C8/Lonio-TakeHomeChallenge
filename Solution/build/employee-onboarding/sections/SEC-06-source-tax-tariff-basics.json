    {
      "id": "US-06.4",
      "title": "Derive the base source tax tariff letter",
      "as_a": "hr",
      "i_want": "the base tariff letter (A, B, C, G or H) to be derived from the employee's type of income, civil status, spouse employment and counted children",
      "so_that": "I know the expected tariff before using the Zurich calculator, which stays the authority for the final tariff",
      "priority": "P1",
      "priority_reason": "The tariff is the output source tax needs; today HR works it out by hand in the calculator for everybody.",
      "acceptance_criteria": [
        {
          "id": "AC-06.4.1",
          "title": "Replacement income gives tariff G",
          "given": "an employee subject to source tax answered \"Replacement income\"",
          "when": "the base tariff letter is derived",
          "then": "the letter is G, whatever the civil status.",
          "examples": [
            {
              "name": "Replacement income",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Germany"
                },
                {
                  "item": "permit_type",
                  "value": "B permit"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                },
                {
                  "item": "income_type",
                  "value": "Replacement income"
                }
              ],
              "then": [
                {
                  "target": "base_tariff_letter",
                  "expect": "G"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-2d4dda"
          ]
        },
        {
          "id": "AC-06.4.2",
          "title": "Married employees get C with a working spouse and B otherwise",
          "given": "a married employee subject to source tax with earned income answered whether the spouse works (see the spouse employment question)",
          "when": "the base tariff letter is derived",
          "then": "the letter is C if the spouse works or receives replacement income (\"yes\"), and B if not (\"no\").",
          "examples": [
            {
              "name": "Spouse works",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Germany"
