    {
      "id": "US-07.3",
      "title": "Determine the source tax outcome for employees living in Liechtenstein",
      "as_a": "source_tax",
      "i_want": "employees living in Liechtenstein to state whether they expect to return home daily and, if not, whether they expect more than 45 work-related non-return days in the year",
      "so_that": "Lonio records the calculator's result: either 'in principle no source tax liability, subject to the double taxation agreement', flagged for HR, or the normal tariff code subject to the double taxation agreement",
      "priority": "P1",
      "priority_reason": "Lonio now owns the source tax result instead of HR's calculator run (D-001). Without these answers a Liechtenstein resident gets no result at all (D-007).",
      "acceptance_criteria": [
        {
          "id": "AC-07.3.1",
          "title": "Liechtenstein residents are asked the cross-border questions",
          "given": "the employee's home address is in Liechtenstein. Living abroad makes them subject to source tax, so HR's rule decides that they are asked.",
          "when": "the employee reaches the source tax details",
          "then": "they must answer 'yes' or 'no' to whether they expect to return daily to their main residence in Liechtenstein. Only if they answer 'no', they must also answer 'yes' or 'no' to whether they expect more than 45 work-related non-return days in the calendar year. The answers are declarations of what they expect and are recorded for source tax. Employees not living in Liechtenstein are not asked.",
          "examples": [
            {
              "name": "Daily return to Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                },
                {
                  "item": "daily_return_liechtenstein",
                  "value": "yes"
                }
              ],
              "then": [
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "required"
                },
                {
                  "target": "non_return_days_45",
                  "expect": "not asked"
                },
                {
                  "target": "daily_return_germany",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "No daily return to Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                },
                {
                  "item": "daily_return_liechtenstein",
                  "value": "no"
                }
              ],
              "then": [
                {
                  "target": "non_return_days_45",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Living in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "not asked"
                },
                {
                  "target": "non_return_days_45",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-981b6b",
            "F-zh_source_tax_calculator-a2041b",
            "F-zh_source_tax_calculator-e22d17",
            "F-zh_source_tax_calculator-e96210",
            "F-zh_source_tax_calculator-0ff846",
            "F-zh_source_tax_calculator-f4ece9",
            "F-hr_transcript-1a20bb",
            "F-hr_transcript-b6d9b3",
            "D-007",
            "D-035"
          ]
        },
        {
          "id": "AC-07.3.2",
          "title": "In principle no source tax liability, or normal tariff code",
          "given": "the employee lives in Liechtenstein and has answered the cross-border questions",
          "when": "Lonio determines the source tax result",
          "then": "Daily return, or at most 45 non-return days, gives 'in principle no source tax liability, subject to the double taxation agreement' instead of a tariff code. This result is recorded for HR with a flag; how HR sees and handles the flag belongs to the later HR-side spec. More than 45 non-return days gives the normal tariff code, subject to the double taxation agreement. For employees not living in Liechtenstein this rule does not apply. The result is always derived again from the latest answers.",
