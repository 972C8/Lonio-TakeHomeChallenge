{
  "id": "SEC-07-living-abroad",
  "order": 7,
  "title": "Employees living abroad (Germany, Liechtenstein)",
  "purpose": "Derive the state of residence from the home address. Ask cross-border commuters in Germany or Liechtenstein about daily return, the certificate of residence and the non-return days they expect, to decide between the cross-border tariff, the normal tariff and the Liechtenstein 'in principle no liability' result.",
  "stories": [
    {
      "id": "US-07.1",
      "title": "Derive the calculator's residence answers from the home address",
      "as_a": "employee",
      "i_want": "Lonio to work out where I live for source tax from the home address I already gave, instead of asking me again whether my main residence is in Switzerland and in which state I live",
      "so_that": "I answer each question only once, and Lonio can still work out the source tax tariff code the way the Zurich calculator does",
      "priority": "P1",
      "priority_reason": "Lonio computes the tariff code itself (D-001). The state of residence decides whether the Germany or Liechtenstein questions apply and whether the tariff can change, so without it no tariff code can be computed for an employee living abroad.",
      "acceptance_criteria": [
        {
          "id": "AC-07.1.1",
          "title": "State of residence follows from the home address country",
          "given": "an employee has entered the country of their home address in the 'Home address' step",
          "when": "Lonio works out the state of residence for source tax",
          "then": "the state of residence is Switzerland when the country is Switzerland, Germany when it is Germany, Liechtenstein when it is Liechtenstein, and 'other country' for any other country. The employee is not asked separately whether their main residence is in Switzerland or which state they live in.",
          "examples": [
            {
              "name": "Employee living in Konstanz (hr_transcript/F-hr_transcript-1a20bb)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Germany"
                }
              ],
              "source_refs": [
                "F-hr_transcript-1a20bb"
              ],
              "illustrative": false
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Liechtenstein"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Switzerland"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in France",
              "given": [
                {
                  "item": "address_country",
                  "value": "France"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Other country"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-f29009",
            "F-zh_source_tax_calculator-4c65ae",
            "F-zh_source_tax_calculator-d62dd4",
            "F-hr_transcript-e505f8",
            "G-01"
          ]
        },
        {
          "id": "AC-07.1.2",
          "title": "Switzerland and other countries leave the base tariff unchanged and get no cross-border questions",
          "given": "an employee lives in Switzerland or in a country other than Germany or Liechtenstein",
          "when": "the employee goes through the questionnaire",
          "then": "no cross-border commuting questions (daily return, certificate of residence, non-return days) are asked, and the state of residence does not change the base tariff letter",
          "examples": [
