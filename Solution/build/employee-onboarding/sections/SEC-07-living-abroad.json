              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Daily return",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                },
                {
                  "item": "daily_return_liechtenstein",
                  "value": "yes"
                }
              ],
              "then": [
                {
                  "target": "non_return_days_45",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
