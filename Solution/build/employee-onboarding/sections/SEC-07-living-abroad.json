                  "value": "Liechtenstein"
                },
                {
                  "item": "daily_return_liechtenstein",
                  "value": "yes"
                }
              ],
              "then": [
                {
                  "target": "liechtenstein_no_source_tax_in_principle",
                  "expect": "yes"
                }
              ],
