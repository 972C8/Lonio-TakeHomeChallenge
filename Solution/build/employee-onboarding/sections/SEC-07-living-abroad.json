{
  "id": "SEC-07-living-abroad",
  "order": 7,
  "title": "Employees living abroad (Germany, Liechtenstein)",
  "purpose": "Derive the calculator's residence answers from the home address country. Ask employees living in Germany or Liechtenstein the cross-border questions about their expected year, which decide the cross-border tariff or the Liechtenstein result.",
  "stories": [
    {
      "id": "US-07.1",
      "title": "Derive the calculator's residence answers from the home address",
      "as_a": "source_tax",
      "i_want": "the calculator's 'main residence in Switzerland?' and 'state of residence' answers to be taken from the country of the employee's home address instead of being asked again",
      "so_that": "the tariff code is based on where the employee really lives, the employee answers their country of residence only once, and only employees living in Germany or Liechtenstein get the extra cross-border questions",
      "priority": "P1",
      "priority_reason": "Lonio now computes the tariff code itself (D-001); the residence decides which cross-border questions apply, and HR finds the abroad cases the hardest part of the calculator (F-hr_transcript-ab8886).",
      "acceptance_criteria": [
        {
          "id": "AC-07.1.1",
          "title": "Residence for source tax follows the home address country",
          "given": "the employee has entered the country of their home address",
          "when": "Lonio determines the employee's residence for the source tax tariff",
          "then": "the residence is Switzerland if the home address is in Switzerland, Germany if it is in Germany, Liechtenstein if it is in Liechtenstein, and 'other country' for any other country; the employee is not asked about their main residence or state of residence again",
          "examples": [
            {
              "name": "Lives in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Switzerland"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Germany"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Liechtenstein"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in France",
              "given": [
                {
                  "item": "address_country",
                  "value": "France"
                }
              ],
              "then": [
                {
                  "target": "source_tax_residence",
                  "expect": "Other country"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-f29009",
            "F-zh_source_tax_calculator-d62dd4",
            "F-zh_source_tax_calculator-80bf97",
