    {
      "id": "US-07.3",
      "title": "Determine the source tax outcome for employees living in Liechtenstein",
      "as_a": "hr",
      "i_want": "employees living in Liechtenstein to state whether they expect to return home daily and, if not, whether they expect more than 45 work-related non-return days in the year, and the result to be recorded as the calculator gives it",
      "so_that": "HR knows whether the employee is in principle not liable to source tax under the double taxation agreement (flagged for HR) or gets a normal tariff code subject to that agreement, without clicking through the calculator",
      "priority": "P1",
      "priority_reason": "Lonio replaces HR's calculator step (D-001); a Liechtenstein employee would otherwise get a wrong tariff code or a wrong deduction, and HR's own rule conflicts with the calculator here (D-007).",
      "acceptance_criteria": [
        {
          "id": "AC-07.3.1",
          "title": "Liechtenstein residents are asked about daily return and non-return days",
          "given": "the employee's home address is in Liechtenstein (which, by HR's rule, makes them subject to source tax)",
          "when": "the employee reaches the source tax questions",
          "then": "the employee must state, yes or no, whether they expect to return daily to their main residence in Liechtenstein; only if not, they must state, yes or no, whether they expect more than 45 work-related non-return days in the calendar year; employees living elsewhere are not asked. The answers are recorded for source tax",
          "examples": [
            {
              "name": "Returns daily",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                },
                {
                  "item": "daily_return_liechtenstein",
                  "value": "yes"
                }
              ],
              "then": [
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "required"
                },
                {
                  "target": "non_return_days_45",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Does not return daily",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                },
                {
                  "item": "daily_return_liechtenstein",
                  "value": "no"
                }
              ],
              "then": [
                {
                  "target": "non_return_days_45",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "not asked"
                },
                {
                  "target": "non_return_days_45",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-981b6b",
            "F-zh_source_tax_calculator-a2041b",
            "F-zh_source_tax_calculator-e22d17",
            "F-zh_source_tax_calculator-e96210",
            "F-zh_source_tax_calculator-0ff846",
            "F-zh_source_tax_calculator-f4ece9",
            "D-007",
            "D-035"
          ]
        },
        {
          "id": "AC-07.3.2",
          "title": "Liechtenstein result follows the calculator",
          "given": "an employee living in Liechtenstein has answered the Liechtenstein questions",
          "when": "Lonio determines the source tax result",
          "then": "with a daily return, or with at most 45 non-return days, the result is 'in principle no source tax liability, subject to the double taxation agreement' instead of a tariff code, and it is flagged for HR (HR's handling of the flag is specified later); with more than 45 non-return days the normal tariff code applies, subject to the double taxation agreement. For employees not living in Liechtenstein this rule does not apply",
          "examples": [
            {
              "name": "Daily return -> in principle no liability (zh_source_tax_calculator/F-zh_source_tax_calculator-e80d8f)",
              "given": [
                {
