{
  "id": "SEC-07-living-abroad",
  "order": 7,
  "title": "Employees living abroad (Germany, Liechtenstein)",
  "purpose": "Derive the calculator's residence answers from the home address country. Ask employees living in Germany or Liechtenstein the cross-border questions about their expected year, which decide the cross-border tariff or the Liechtenstein result.",
  "stories": [
    {
      "id": "US-07.1",
      "title": "Derive the calculator's residence answers from the home address",
      "as_a": "source_tax",
      "i_want": "the employee's state of residence for the Zurich tariff (Switzerland, Germany, Liechtenstein or another country) to be taken from the country of the home address, without asking the calculator's residence questions again",
      "so_that": "each fact is asked once, and the right cross-border questions and base tariff follow from where the employee actually lives",
      "priority": "P1",
      "priority_reason": "Lonio computes the tariff code itself (D-001). Without the state of residence, no tariff code can be computed for employees living abroad, and today HR has to work out the extra cross-border questions by hand (F-hr_transcript-ab8886).",
