    {
      "id": "US-07.2",
      "title": "Decide the cross-border tariff for employees living in Germany",
      "as_a": "source_tax",
      "i_want": "employees living in Germany to say whether they return home daily, whether they have provided a certificate of residence, whether a daily return would be reasonable and whether they expect more than 60 work-related non-return days",
      "so_that": "Lonio applies the cross-border tariff (letters L, M, N, P) or the normal tariff exactly as the Zurich calculator does",
      "priority": "P1",
      "priority_reason": "HR finds the questions for employees living abroad the hardest part of the calculator (F-hr_transcript-ab8886). Lonio now owns the tariff result (D-001), so a wrong cross-border decision gives a wrong tariff code.",
      "acceptance_criteria": [
        {
          "id": "AC-07.2.1",
          "title": "Daily return is asked only of employees living in Germany",
          "given": "the employee's home address country is Germany, so they are subject to source tax whatever their nationality",
          "when": "the employee reaches the 'Cross-border commuting' step, after the children",
          "then": "the employee must say whether they expect to return daily to their main residence in Germany (yes or no). Employees living anywhere else are not asked. The answer is recorded for the source tax tariff code.",
          "examples": [
            {
