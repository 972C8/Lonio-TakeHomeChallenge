    {
      "id": "US-07.3",
      "title": "Determine the source tax outcome for employees living in Liechtenstein",
      "as_a": "hr",
      "i_want": "employees living in Liechtenstein to say whether they return home daily and, if not, whether they expect more than 45 work-related non-return days",
      "so_that": "Lonio records either 'in principle no source tax liability, subject to the double taxation agreement', flagged for me, or the normal tariff code, as the Zurich calculator does",
      "priority": "P1",
      "priority_reason": "Employees living abroad are always asked the source tax questions (F-hr_transcript-1a20bb, D-007). Without these answers Lonio cannot give the Liechtenstein result that the calculator shows, and HR would have to go back to the calculator.",
      "acceptance_criteria": [
        {
          "id": "AC-07.3.1",
          "title": "Daily return is asked only of employees living in Liechtenstein",
          "given": "the employee's home address country is Liechtenstein, so they are subject to source tax and get the source tax questions",
          "when": "the employee reaches the 'Cross-border commuting' step, after the children",
          "then": "the employee must say whether they expect to return daily to their main residence in Liechtenstein (yes or no). Employees living anywhere else are not asked. The answer is recorded for the source tax result.",
          "examples": [
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "required"
                },
                {
                  "target": "daily_return_germany",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-981b6b",
            "F-zh_source_tax_calculator-a2041b",
            "F-zh_source_tax_calculator-e22d17",
            "F-hr_transcript-1a20bb",
            "D-007",
            "D-035"
          ]
        },
        {
          "id": "AC-07.3.2",
          "title": "Non-return days are asked only without daily return",
          "given": "an employee living in Liechtenstein has answered the daily return question",
          "when": "the employee continues the cross-border questions",
          "then": "only if they do not return daily must they say whether they expect more than 45 work-related non-return days in the calendar year, yes or no. This is a declaration of what they expect for the year; no proof is asked and no document is uploaded.",
          "examples": [
            {
              "name": "No daily return",
              "given": [
                {
                  "item": "address_country",
