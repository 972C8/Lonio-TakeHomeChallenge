    {
      "id": "US-08.4",
      "title": "Liechtenstein: daily return and more than 45 non-return days",
      "as_a": "source_tax",
      "i_want": "employees living in Liechtenstein to state first whether they return daily and, if not, whether they expect more than 45 non-return days",
      "so_that": "Lonio records 'in principle no source tax liability, subject to the double taxation agreement' or the normal tariff code as the calculator does, and skips tariff questions that are not needed",
      "priority": "P1",
      "priority_reason": "Decides whether source tax is deducted at all for Liechtenstein residents; Lonio owns the result (D-001, D-007) and must not ask tariff questions that no party needs (G-01).",
      "acceptance_criteria": [
        {
          "id": "AC-08.4.1",
          "title": "Liechtenstein questions are asked first",
