{
  "id": "SEC-08-cross-border-residence",
  "order": 6,
  "title": "Source tax: residence abroad and cross-border questions",
  "purpose": "For employees living in Germany or Liechtenstein, ask the cross-border questions to decide between the cross-border tariff, the normal tariff and 'in principle no source tax liability' for Liechtenstein, including the separate note on the double taxation agreement.",
  "stories": [
    {
      "id": "US-08.1",
      "title": "Derive the calculator's residence answers from the home address and ask cross-border questions only of Germany and Liechtenstein residents",
      "as_a": "employee",
      "i_want": "Lonio to take my country of residence from the home address I already gave, and to ask me cross-border questions only if I live in Germany or Liechtenstein",
      "so_that": "I do not answer the same question twice or answer questions that do not apply to me, while Lonio still has everything it needs to compute my source tax tariff code",
      "priority": "P1",
      "priority_reason": "Lonio computes the full tariff code itself (D-001); without the residence answers the tariff code for employees living abroad cannot be computed. HR today does not know up front who must answer which questions (F-hr_transcript-b84498, F-hr_transcript-8595fb).",
      "acceptance_criteria": [
        {
          "id": "AC-08.1.1",
          "title": "Residence for the tariff calculation is derived, not asked",
          "given": "the employee has entered the country of their home address as it applies on the first working day (step 2 Home address)",
          "when": "Lonio determines the residence for the source tax tariff calculation",
          "then": "the calculator's questions 'main residence in Switzerland?' and 'country of residence' are not asked again; the residence is Switzerland for Switzerland, Germany for Germany, Liechtenstein for Liechtenstein, and 'Other country' for any other country. Switzerland and 'Other country' lead to the base tariff without further residence questions. This derivation is inferred from the calculator's options and is covered by the go-live check of the computed tariff code (see OQ-calculator-coverage).",
          "examples": [
            {
              "name": "Lives in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "calculator_residence",
                  "expect": "Switzerland"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in Germany (Konstanz, hr_transcript/F-hr_transcript-3f2c2a)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "calculator_residence",
                  "expect": "Germany"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "calculator_residence",
                  "expect": "Liechtenstein"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in France",
              "given": [
                {
                  "item": "address_country",
                  "value": "France"
                }
              ],
              "then": [
                {
                  "target": "calculator_residence",
                  "expect": "Other country"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-aedb40",
