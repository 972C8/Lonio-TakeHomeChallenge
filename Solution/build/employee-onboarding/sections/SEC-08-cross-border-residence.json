{
  "id": "SEC-08-cross-border-residence",
  "order": 8,
  "title": "Source tax: residence abroad and cross-border questions",
  "purpose": "Answer the calculator's residence questions from the home address. Ask employees living in Germany or Liechtenstein only the daily-return and non-return-day questions that decide between the cross-border tariff and the normal tariff.",
  "stories": [
    {
      "id": "US-08.1",
      "title": "Derive the calculator's residence answers from the home address",
      "as_a": "source_tax",
      "i_want": "the Zurich calculator's 'main residence in Switzerland?' and 'country of residence' questions to be answered from the country of the employee's home address",
      "so_that": "the tariff can be determined without asking the employee for their residence a second time, and only the residence questions that apply to their country follow",
      "priority": "P1",
      "priority_reason": "Every source tax tariff determination needs the residence answers; residence abroad is what makes the calculator 'much more complicated' for HR (F-hr_transcript-8595fb), and asking each piece of information once is a core goal (G-01).",
      "acceptance_criteria": [
        {
          "id": "AC-08.1.1",
          "title": "Residence is not asked again for source tax",
          "given": "the employee has entered the country of their home address (address_country) in the home address step",
          "when": "the employee reaches the source tax questions",
          "then": "the employee is not asked whether their main residence is in Switzerland nor for their country of residence; both answers for the source tax calculator come from the country of the home address",
          "examples": [],
          "source_refs": [
            "F-zh_source_tax_calculator-aedb40",
            "F-zh_source_tax_calculator-4c65ae",
            "G-01",
            "G-08"
          ]
        },
        {
          "id": "AC-08.1.2",
          "title": "Residence answers per country of the home address",
          "given": "the country of the employee's home address is known",
          "when": "the residence answers for the source tax calculator are derived",
          "then": "Switzerland gives 'main residence in Switzerland: yes'; Germany gives 'main residence in Switzerland: no' and country of residence Germany, followed by the Germany questions; Liechtenstein gives 'main residence in Switzerland: no' and country of residence Liechtenstein, followed by the Liechtenstein questions; any other country gives 'main residence in Switzerland: no' and country of residence 'other country'",
          "examples": [
            {
              "name": "Tomás, lives in Winterthur (F-hr_transcript-b90bd9)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
