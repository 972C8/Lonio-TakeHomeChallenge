    {
      "id": "US-08.2",
      "title": "Germany: daily return and certificate of residence",
      "as_a": "source_tax",
      "i_want": "employees living in Germany to state whether they return home daily and, if so, whether they have a certificate of residence",
      "so_that": "the cross-border tariff is applied only when the calculator's conditions are met and the normal tariff otherwise",
      "priority": "P1",
      "priority_reason": "The answer changes the tariff letter (e.g. N1Y instead of C1Y); Lonio owns the tariff code (D-001) and HR could never remember the German forms (F-hr_transcript-8595fb).",
      "acceptance_criteria": [
        {
          "id": "AC-08.2.1",
          "title": "Daily return to Germany is asked of Germany residents",
          "given": "the employee lives in Germany",
          "when": "the employee reaches step 5 Cross-border commuting",
          "then": "the employee is asked whether they return daily to their main residence in Germany, as they expect it for the year; the answer is required and is 'yes' or 'no'. It is recorded for the source tax tariff code. Employees living elsewhere are not asked.",
          "examples": [
            {
              "name": "Lives in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "daily_return_germany",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Lives in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "daily_return_germany",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-zh_source_tax_calculator-69edd5",
            "F-zh_source_tax_calculator-64ac42",
            "F-zh_source_tax_calculator-31d762",
            "D-035",
            "D-047"
          ]
        },
        {
          "id": "AC-08.2.2",
          "title": "Certificate of residence is asked only with daily return",
          "given": "the employee lives in Germany",
          "when": "the employee answers that they return daily",
          "then": "the employee is asked whether they have a certificate of residence for HR; the answer is required and is 'yes', 'no' or 'not yet'. A new hire often has no certificate yet, so 'not yet' is valid. Nothing is uploaded: the document goes to HR outside Lonio. Employees who do not return daily are not asked.",
          "examples": [
            {
              "name": "Germany, daily return",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                },
                {
                  "item": "daily_return_germany",
                  "value": "yes"
                }
              ],
              "then": [
