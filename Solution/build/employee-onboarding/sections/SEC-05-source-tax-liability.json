    {
      "id": "US-05.3",
      "title": "Decide whether the employee is subject to source tax",
      "as_a": "hr",
      "i_want": "Lonio to decide from the employee's answers whether they are subject to source tax",
      "so_that": "I know up front who has to answer the source tax questions, and only those employees are asked them",
      "priority": "P1",
      "priority_reason": "HR 'never knows up front' who must answer the source tax questions. This decision controls the whole source tax section and the data minimisation for sensitive data such as religious denomination.",
      "acceptance_criteria": [
        {
          "id": "AC-05.3.1",
          "title": "Employees living abroad are always subject",
          "given": "the employee's home address is in a country other than Switzerland",
          "when": "Lonio decides whether the employee is subject to source tax",
          "then": "the employee is subject to source tax, whatever their nationality. No nationality, permit or spouse questions are needed for this decision. How Liechtenstein residents whom the calculator may treat as not liable are handled is open (see OQ-liechtenstein).",
          "examples": [
            {
              "name": "Swiss national living in Germany, like Stefan (F-hr_transcript-3f2c2a)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-3f2c2a",
            "F-hr_transcript-5af8d0"
          ]
        },
        {
          "id": "AC-05.3.2",
          "title": "Swiss nationals and C-permit holders living in Switzerland are not subject",
          "given": "the employee lives in Switzerland",
          "when": "the employee is Swiss, or is not Swiss but holds a C permit",
          "then": "the employee is not subject to source tax, whatever their civil status. C-permit holders are treated like Swiss nationals.",
          "examples": [
            {
              "name": "Swiss national living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Switzerland"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "no"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Maria, Portuguese, C permit (hr_transcript/F-hr_transcript-845204)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Portugal"
                },
                {
                  "item": "permit_type",
                  "value": "C permit"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "no"
                }
              ],
              "source_refs": [],
              "illustrative": false
            }
          ],
          "source_refs": [
            "F-hr_transcript-b0527c",
            "F-hr_transcript-845204",
            "F-hr_transcript-5af8d0"
          ]
        },
        {
