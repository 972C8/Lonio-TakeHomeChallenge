{
  "id": "SEC-05-source-tax-liability",
  "order": 5,
  "title": "Who is subject to source tax",
  "purpose": "Ask only what HR's rule needs (nationality, C permit, and the spouse's nationality, C permit and whether the spouse lives in Switzerland) to decide whether the employee is subject to source tax.",
  "stories": [
    {
      "id": "US-05.1",
      "title": "Ask nationality and C permit only of employees living in Switzerland",
      "as_a": "hr",
      "i_want": "Lonio to ask an employee who lives in Switzerland for their nationality and, if they are not Swiss, only whether they hold a C permit",
      "so_that": "I can tell whether the employee is subject to source tax without collecting nationality or permit data from people for whom it changes nothing (employees living abroad are always subject to source tax)",
      "priority": "P1",
      "priority_reason": "Nationality and C permit decide source tax liability for everyone living in Switzerland; without them HR cannot tell who has to answer the source tax questions (F-hr_transcript-b84498).",
      "acceptance_criteria": [
        {
          "id": "AC-05.1.1",
          "title": "Nationality is required only from employees living in Switzerland",
          "given": "the employee has entered the country of their home address in step 2 (the address that applies on the first working day)",
          "when": "the employee reaches step 3 'Nationality and C permit'",
          "then": "if the home address is in Switzerland, the nationality is asked and required; if the home address is in any other country, the nationality is not asked, because an employee living abroad is subject to source tax whatever their passport. The nationality is recorded for HR to decide source tax liability and whether the permit reminder applies.",
