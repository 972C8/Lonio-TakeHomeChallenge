{
  "id": "SEC-05-source-tax-liability",
  "order": 5,
  "title": "Who is subject to source tax",
  "purpose": "Ask only the nationality, permit and spouse questions needed to decide whether the employee is subject to source tax. This tells HR up front who must answer the source tax questions and replaces the manual email follow-up about the spouse.",
  "stories": [
    {
      "id": "US-05.1",
      "title": "Ask nationality and permit only of employees living in Switzerland",
      "as_a": "employee",
      "i_want": "to be asked for my nationality and, if I am not Swiss, my Swiss permit only when this can change whether I am subject to source tax",
      "so_that": "Lonio can tell whether I must answer the source tax questions without collecting personal data that no receiving party needs for me",
      "priority": "P1",
      "priority_reason": "Source tax liability cannot be decided without these answers. HR says it never knows up front who has to answer the source tax questions, and data minimisation forbids asking them of everybody.",
      "acceptance_criteria": [
        {
          "id": "AC-05.1.1",
          "title": "Nationality is asked only of employees who live in Switzerland",
          "given": "the employee has given the country of their home address (asked in the home address step)",
          "when": "the employee reaches the nationality and permit step",
          "then": "the nationality is asked and required if the home address is in Switzerland. It is not asked if the home address is in another country, because employees who live abroad are subject to source tax whatever their nationality.",
          "examples": [
            {
              "name": "Employee living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "asked"
                },
                {
                  "target": "nationality",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Swiss national living in Germany, like Stefan (F-hr_transcript-3f2c2a)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-35fae3",
            "F-hr_transcript-3f2c2a",
            "F-hr_transcript-5af8d0",
            "G-01"
          ]
        },
        {
          "id": "AC-05.1.2",
          "title": "Permit type is asked only of non-Swiss employees living in Switzerland",
          "given": "the employee lives in Switzerland and has given their nationality",
          "when": "the nationality is not Switzerland",
          "then": "the employee's Swiss permit type is asked and required. Swiss nationals and employees who live abroad are not asked for a permit.",
