    {
      "id": "US-05.3",
      "title": "Decide whether the employee is subject to source tax",
      "as_a": "hr",
      "i_want": "Lonio to decide from the employee's answers whether they are subject to source tax, following my final rule",
      "so_that": "only employees subject to source tax are asked the tariff questions and I no longer have to work out up front who must answer them",
      "priority": "P1",
      "priority_reason": "The decision gates the whole source tax part; HR 'never knows up front' who has to answer and the rule took several corrections (F-hr_transcript-b84498, F-hr_transcript-550840).",
      "acceptance_criteria": [
        {
          "id": "AC-05.3.1",
          "title": "Employees living abroad are always subject",
          "given": "the employee's country of residence is not Switzerland",
          "when": "Lonio decides source tax liability",
          "then": "the employee is subject to source tax whatever their nationality or civil status. This includes Liechtenstein residents, who are asked the source tax questions even though their result may be 'in principle no source tax liability' (see the Liechtenstein rule).",
          "examples": [
            {
              "name": "Stefan, Swiss living abroad (hr_transcript/F-hr_transcript-3f2c2a), country assumed",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Married employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
