    {
      "id": "US-05.3",
      "title": "Decide whether the employee is subject to source tax",
      "as_a": "source_tax",
      "i_want": "Lonio to decide for every employee, from the answers given, whether they are subject to source tax, following HR's consolidated rule",
      "so_that": "only employees subject to source tax answer the tariff questions and get a tariff code, and nobody is wrongly left out or included",
      "priority": "P1",
      "priority_reason": "HR's own rule changed several times during the interview and HR never knows up front who has to answer the source tax questions; a wrong decision means wrong withholding (F-hr_transcript-b0527c, F-hr_transcript-845204, F-hr_transcript-b84498).",
      "acceptance_criteria": [
        {
          "id": "AC-05.3.1",
          "title": "Employees living abroad are always subject",
          "given": "an employee's home address on the first working day is in a country other than Switzerland",
          "when": "Lonio decides source tax liability",
          "then": "the employee is subject to source tax whatever their nationality, even a Swiss citizen such as Stefan. 'Here' in HR's wording is read as Switzerland (decision D-043, an assumption to be verified by a domain expert). How Liechtenstein residents are then treated under the double taxation agreement is decided by the Liechtenstein questions, not by this rule.",
          "examples": [
            {
              "name": "Swiss citizen living abroad, like Stefan (hr_transcript/F-hr_transcript-3f2c2a)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
