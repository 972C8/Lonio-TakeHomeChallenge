    {
      "id": "US-05.3",
      "title": "Decide whether the employee is subject to source tax",
      "as_a": "source_tax",
      "i_want": "Lonio to decide from the employee's answers whether they are subject to source tax, following HR's consolidated rule",
      "so_that": "every employee who must pay source tax gets a tariff code and nobody who is exempt is charged",
      "priority": "P1",
      "priority_reason": "Liability decides whether a tariff code is needed at all; HR corrected its own rule twice in the interview, showing the risk of errors (F-hr_transcript-845204, F-hr_transcript-5af8d0).",
      "acceptance_criteria": [
        {
          "id": "AC-05.3.1",
          "title": "Employees living abroad are always subject",
          "given": "the employee's home address on the first working day is outside Switzerland",
          "when": "Lonio decides source tax liability",
          "then": "the employee is subject to source tax whatever their nationality or civil status; even a Swiss citizen living abroad is subject.",
          "examples": [
            {
              "name": "Employee living in Konstanz (hr_transcript/F-hr_transcript-3f2c2a)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
              "name": "Stefan, Swiss citizen living abroad (hr_transcript/F-hr_transcript-3f2c2a)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                },
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in France",
              "given": [
                {
                  "item": "address_country",
                  "value": "France"
                },
                {
                  "item": "civil_status",
                  "value": "Divorced"
                }
              ],
              "then": [
                {
                  "target": "subject_to_source_tax",
                  "expect": "yes"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "F-hr_transcript-3f2c2a",
            "F-hr_transcript-5af8d0"
          ]
        },
        {
          "id": "AC-05.3.2",
          "title": "Swiss nationals and C-permit holders living in Switzerland are not subject",
          "given": "the employee lives in Switzerland",
          "when": "the nationality is Switzerland (also as one of several nationalities), or the employee is not Swiss and holds a C permit",
          "then": "the employee is not subject to source tax, whatever their civil status. Assumption - to be verified by a domain expert: anyone with Swiss citizenship counts as Swiss (D-008).",
          "examples": [
