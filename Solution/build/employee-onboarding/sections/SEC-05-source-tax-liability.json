    {
      "id": "US-05.3",
      "title": "Decide whether the employee is subject to source tax",
      "as_a": "hr",
      "i_want": "Lonio to decide from the answers whether the new employee is subject to source tax, following our consolidated rule",
      "so_that": "I know up front who has to answer the source tax questions and who needs a tariff code, instead of working it out by hand",
      "priority": "P1",
      "priority_reason": "HR 'never knows up front' who has to answer the source tax questions (F-hr_transcript-b84498); this decision gates all source tax questions and the tariff code.",
      "acceptance_criteria": [
        {
          "id": "AC-05.3.1",
          "title": "Employees living abroad are always subject to source tax",
          "given": "the home address on the first working day is in any country other than Switzerland",
          "when": "Lonio decides source tax liability",
          "then": "the employee is subject to source tax whatever their nationality or civil status (HR's consolidated rule, which replaces the first version 'all non-Swiss employees').",
          "examples": [
            {
              "name": "Stefan, Swiss citizen living abroad (hr_transcript/F-hr_transcript-3f2c2a; country assumed Germany)",
