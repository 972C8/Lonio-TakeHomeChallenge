            {
              "name": "Employee living in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "permit_type",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
