{
  "id": "SEC-05-source-tax-liability",
  "order": 5,
  "title": "Who is subject to source tax",
  "purpose": "Decide whether the employee is subject to source tax. Ask nationality and C permit only of residents of Switzerland. Ask the spouse's nationality, C permit and residence only when needed to check the spouse exemption.",
  "stories": [
    {
      "id": "US-05.1",
      "title": "Ask nationality and C permit only of employees living in Switzerland",
      "as_a": "employee",
      "i_want": "to be asked my nationality and, if I am not Swiss, only whether I hold a C permit - and only when I live in Switzerland",
      "so_that": "Lonio can decide whether I am subject to source tax without collecting nationality or permit data that no receiving party needs for me (data minimisation)",
      "priority": "P1",
      "priority_reason": "Source tax liability cannot be decided for residents of Switzerland without these answers; HR names nationality and the C permit as the deciding facts (F-hr_transcript-5af8d0, F-hr_transcript-845204).",
      "acceptance_criteria": [
        {
          "id": "AC-05.1.1",
          "title": "Nationality is asked and required only of employees living in Switzerland",
          "given": "the employee has entered the country of their home address as it applies on the first working day (step 2 'Home address')",
          "when": "the employee reaches step 3 'Nationality and C permit'",
          "then": "the nationality is asked and required if the country of residence is Switzerland; it is not asked of employees living abroad, who are subject to source tax whatever their nationality (D-038). Nationality is recorded for HR to decide source tax liability and whether the permit reminder applies.",
          "examples": [
            {
              "name": "Maria (hr_transcript/F-hr_transcript-845204)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Portugal"
                }
