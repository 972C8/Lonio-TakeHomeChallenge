{
  "id": "SEC-05-source-tax-liability",
  "order": 5,
  "title": "Who is subject to source tax",
  "purpose": "Decide from as few questions as possible whether the employee is subject to source tax: country of residence, Swiss citizenship, C permit (yes/no), and the spouse's citizenship, C permit and residence. Only employees subject to source tax are asked the tariff questions.",
  "stories": [
    {
      "id": "US-05.1",
      "title": "Ask nationality and C permit only of employees living in Switzerland",
      "as_a": "employee",
      "i_want": "to be asked my nationality and, if I am not Swiss, only whether I hold a C permit, and only when I live in Switzerland",
      "so_that": "Lonio can tell whether I am subject to source tax without collecting citizenship or permit details that no receiving party needs for me",
      "priority": "P1",
      "priority_reason": "Nationality and the C permit decide who must answer the source tax questions; HR's rule needed several corrections and today HR 'never knows up front' who has to answer (F-hr_transcript-b84498, F-hr_transcript-5af8d0).",
      "acceptance_criteria": [
        {
          "id": "AC-05.1.1",
          "title": "Nationality is asked only of employees living in Switzerland",
          "given": "the employee has entered the country of their home address (their country of residence)",
          "when": "the country of residence is Switzerland",
          "then": "the employee is asked their nationality (country named in English) and must answer it; employees living in any other country are not asked their nationality, because for them it does not change the source tax outcome. The answer is recorded for source tax (liability) and for HR (whether the permit reminder is shown).",
          "examples": [
            {
              "name": "Maria (hr_transcript/F-hr_transcript-845204)",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "asked"
                },
                {
                  "target": "nationality",
                  "expect": "required"
                }
              ],
              "source_refs": [],
              "illustrative": false
            },
            {
              "name": "Stefan, Swiss living abroad (hr_transcript/F-hr_transcript-3f2c2a), country assumed",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Liechtenstein",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                }
              ],
              "then": [
                {
                  "target": "nationality",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
