    {
      "id": "US-01.3",
      "title": "Ask each piece of information once and reuse it for every receiving party",
      "as_a": "hr",
      "i_want": "each piece of information to be asked from the employee only once and recorded for every party that needs it (HR, Pensionskasse Muster, source tax)",
      "so_that": "I no longer re-enter the same data for each party and registrations are not blocked by missing data such as the spouse's date of birth",
      "priority": "P1",
      "priority_reason": "Missing data blocks registrations today (the fund cannot register a married employee without the spouse's date of birth) and asking once is the core goal of the feature (G-01).",
      "acceptance_criteria": [
        {
          "id": "AC-01.3.1",
          "title": "Shared answers are asked once",
          "given": "an answer is needed by more than one party, such as civil status (pension fund and source tax) or country of residence (HR, pension fund and source tax)",
          "when": "the employee goes through the questionnaire",
          "then": "the question appears exactly once and its answer is recorded for HR for every party that needs it; how the data reaches each party is a separate topic and not part of this questionnaire",
          "examples": [
            {
              "name": "Civil status used by fund and source tax",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                },
                {
                  "item": "civil_status",
                  "value": "Married"
                }
              ],
              "then": [
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "address_country",
                  "expect": "asked"
                },
                {
                  "target": "spouse_date_of_birth",
                  "expect": "asked"
                },
                {
                  "target": "spouse_gainful_employment",
                  "expect": "asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "G-01",
            "G-04",
            "D-034",
            "F-hr_transcript-ce8ca4",
            "F-zh_source_tax_calculator-9007c3"
          ]
        },
        {
          "id": "AC-01.3.2",
          "title": "A question is asked only when a party needs it for this person",
          "given": "the employee's earlier answers show that no party needs a piece of information for them",
          "when": "the questionnaire reaches that question",
          "then": "the question is not asked. For example, the spouse's or partner's date of birth is asked from married, registered-partnership and separated employees, not from divorced or widowed ones. Assumption, to be verified by a domain expert: registered partnership and separated are entered at the fund as Married, which requires the spouse's date of birth (D-003, D-004). Nothing outside the needs of HR, the pension fund and source tax is asked (no AHV data, IT equipment, permit type or income type).",
          "examples": [
            {
              "name": "Divorced employee",
