    {
      "id": "US-01.2",
      "title": "Ask the steps in an order that avoids unneeded questions",
      "as_a": "employee",
      "i_want": "to answer one short English questionnaire in a fixed order of steps, where each step only appears when it applies to me",
      "so_that": "I answer only what a receiving party needs from me and every later step can depend on what I already said",
      "priority": "P1",
      "priority_reason": "The order is what makes conditional questions possible; without it the questionnaire either blocks registrations or over-collects personal data (G-01).",
      "acceptance_criteria": [
        {
          "id": "AC-01.2.1",
          "title": "Steps and order",
          "given": "a new employee opens the questionnaire",
          "when": "they go through it",
          "then": "the questionnaire is in English and has these steps in this order: 1 Personal details (first name, last name, date of birth - always); 2 Start (first working day, the contractual start date even on a weekend or public holiday - always); 3 Home address as on the first working day (street, house number or 'no house number', postcode, town, country - always; canton only if living in Switzerland); 4 Nationality and permit (only if living in Switzerland: nationality, and whether they hold a C permit if not Swiss); 5 Civil status and spouse; 6 Liechtenstein cross-border (only if living in Liechtenstein); 7 Source tax personal details (denomination; spouse employment if married or in a registered partnership); 8 Children; 9 Germany cross-border (only if living in Germany); 10 Summary and submission. Steps 7 to 9 appear only when a tariff code is needed. Assumptions, to be verified by a domain expert: the first working day is the contractual start date (D-039); address and country are those on the first working day (D-041); the house number is required, with a 'no house number' option (D-042); employees living abroad are not asked for the canton, Zurich is entered for them (D-002); there is no maximum number of children and a child's age is judged on the first working day (D-044).",
          "examples": [
            {
              "name": "Swiss citizen living in Switzerland",
              "given": [
                {
                  "item": "address_country",
                  "value": "Switzerland"
                },
                {
                  "item": "nationality",
                  "value": "Switzerland"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "residence_canton",
                  "expect": "asked"
                },
                {
                  "target": "nationality",
                  "expect": "asked"
                },
                {
                  "target": "holds_c_permit",
                  "expect": "not asked"
                },
                {
                  "target": "civil_status",
                  "expect": "asked"
                },
                {
                  "target": "confession",
                  "expect": "not asked"
                },
                {
                  "target": "daily_return_germany",
                  "expect": "not asked"
                },
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            },
            {
              "name": "Employee living in Germany",
              "given": [
                {
                  "item": "address_country",
                  "value": "Germany"
                },
                {
                  "item": "civil_status",
                  "value": "Single"
                }
              ],
              "then": [
                {
                  "target": "residence_canton",
                  "expect": "not asked"
                },
                {
                  "target": "nationality",
                  "expect": "not asked"
                },
                {
                  "target": "holds_c_permit",
                  "expect": "not asked"
                },
                {
                  "target": "confession",
                  "expect": "asked"
                },
                {
                  "target": "has_children",
                  "expect": "asked"
                },
                {
                  "target": "daily_return_germany",
                  "expect": "asked"
                },
                {
                  "target": "daily_return_liechtenstein",
                  "expect": "not asked"
                }
              ],
              "source_refs": [],
              "illustrative": true
            }
          ],
          "source_refs": [
            "G-09",
            "F-hr_transcript-c0fe95",
            "D-001",
            "D-002",
            "D-033",
            "D-039",
            "D-041",
            "D-042",
            "D-044"
          ]
        },
        {
          "id": "AC-01.2.2",
          "title": "Liechtenstein cross-border questions come first and can skip the tariff questions",
          "given": "the employee lives in Liechtenstein",
          "when": "they reach the source tax part of the questionnaire",
          "then": "they are first asked whether they expect to return daily to their main residence in Liechtenstein and, if not, whether they expect more than 45 work-related non-return days in the calendar year; this comes before denomination, spouse employment and children. With daily return or at most 45 non-return days the result is 'in principle no source tax liability, subject to the double taxation agreement', flagged for HR, and denomination, spouse employment and children are not asked. With more than 45 non-return days these questions are asked and the normal tariff code is recorded with the note 'subject to the double taxation agreement', flagged for HR. Assumption, to be verified by a domain expert (D-040). How HR sees the flag belongs to the later HR-side spec (see OQ-hr-side-follow-ups).",
          "examples": [
            {
              "name": "Liechtenstein, daily return",
              "given": [
                {
                  "item": "address_country",
                  "value": "Liechtenstein"
                },
                {
                  "item": "civil_status",
                  "value": "Married"
                },
                {
                  "item": "daily_return_liechtenstein",
                  "value": "yes"
                }
