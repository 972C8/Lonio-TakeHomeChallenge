    {
      "id": "US-01.6",
      "title": "Make the questionnaire read-only after submission and derive results from the latest answers",
      "as_a": "hr",
      "i_want": "the questionnaire to be read-only for the employee once submitted, with later changes made by HR and every derived result always computed again from the latest answers",
      "so_that": "the recorded data stays consistent and the insurance start date, civil status for the fund and for source tax, source tax liability and tariff code always match the current facts, for example when the first working day moves",
      "priority": "P2",
      "priority_reason": "The first working day often moves and the insurance start date depends on it; stale derived values would give wrong registrations, but HR handles the changes.",
      "acceptance_criteria": [
        {
          "id": "AC-01.6.1",
          "title": "Employee cannot change answers after submission",
          "given": "the employee has submitted the questionnaire",
          "when": "they open it again",
          "then": "they can see their answers but cannot change them; any later change (a move, a marriage, a new child, a certificate of residence handed in later, a corrected nationality, a new first working day) is made by HR. How HR makes these changes belongs to the later HR-side spec (see OQ-hr-side-follow-ups).",
          "examples": [],
          "source_refs": [
            "D-037",
            "D-033",
            "D-034"
          ]
        },
        {
          "id": "AC-01.6.2",
          "title": "Derived results follow the latest answers",
          "given": "an answer has been changed after submission",
          "when": "the derived results are looked at",
          "then": "the insurance start date, the civil status for the pension fund and for source tax, whether the employee is subject to source tax and the tariff code are derived again from the latest answers; for the first working day the latest date always counts and no history of earlier dates is kept. Assumption, to be verified by a domain expert: the insurance start date is derived only from the first working day, which is the contractual start date (D-039).",
          "examples": [],
          "source_refs": [
            "D-037",
            "D-033",
            "D-039",
            "F-hr_transcript-e3721e"
          ]
        }
      ],
