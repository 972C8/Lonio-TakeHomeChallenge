    {
      "id": "US-01.5",
      "title": "Discard answers that no longer apply on submission",
      "as_a": "employee",
      "i_want": "answers to questions that no longer apply after I change an earlier answer to be discarded when I submit, while being kept until then",
      "so_that": "I can go back and forth without losing input, and no personal data is kept that no party needs",
      "priority": "P2",
      "priority_reason": "Required by data minimisation (G-01) but it affects only employees who change earlier answers; it blocks no registration.",
      "acceptance_criteria": [
        {
          "id": "AC-01.5.1",
          "title": "Answers kept while editing",
          "given": "the employee has answered a question and then changes an earlier answer so that the question no longer applies",
          "when": "they change the earlier answer back before submitting",
          "then": "their previous answer to the question is still there and they do not have to enter it again",
