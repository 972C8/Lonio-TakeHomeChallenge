      "id": "Q01",
      "page_text": "Für welche Einkünfte möchten Sie den Quellensteuertarif ermitteln?",
      "control": "radio",
      "options": [
        "Erwerbseinkommen",
        "Ersatzeinkünfte"
      ],
      "required": "yes",
      "shown_when": "always",
      "help_text": "Calculator heading: 'Quellensteuertarif bestimmen'. Result box 'Ergebnis' shows 'Es fehlen noch Angaben um die Tarifbestimmung abzuschliessen.' until complete; reset button 'Neue Tarifbestimmung ermitteln'. Ersatzeinkünfte skips all personal/child questions and goes straight to Q16."
    },
    {
      "id": "Q02",
      "page_text": "Zivilstand",
      "control": "radio",
      "options": [
        "Verheiratet oder eingetragene Partnerschaft",
        "Ledig, Geschieden, Getrennt, Verwitwet"
      ],
      "required": "yes",
      "shown_when": "Q01 = Erwerbseinkommen",
      "help_text": "Section heading: 'Angaben zur quellensteuerpflichtigen Person'"
    },
    {
      "id": "Q03",
      "page_text": "Konfession",
      "control": "radio",
      "options": [
        "röm.-kath., christ.-kath., evang.-ref.",
        "Keine oder andere"
      ],
      "required": "yes",
      "shown_when": "Q01 = Erwerbseinkommen AND Q02 answered",
